# Grooming Voice — environment template (NO real secrets here)
# Copy to .env.local and fill in real values locally. Never commit .env.local.

# --- ElevenLabs (Agents runtime) ---
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Static secret shared with the ElevenLabs agent webhook tools (server-side only).
WEBHOOK_TOOL_SECRET=

# --- Supabase (Postgres + Auth) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Session capability ---
# HMAC secret used to derive per-session capability tokens (server-side only).
SESSION_CAPABILITY_SECRET=

# --- Demo gate + tenant ---
# Code required by POST /api/voice/session ({} demoCode). When unset the gate
# FAILS CLOSED unless ALLOW_UNGATED_LOCAL_DEV=1 AND NODE_ENV!=production.
DEMO_CODE=
ALLOW_UNGATED_LOCAL_DEV=
# Tenant id used by the server when creating conversations. Defaults to studio_demo.
STUDIO_ID=

# --- Demo studio login (Supabase Auth) ---
# The auth user id seeded as studio owner/member (see db/004_seed.sql).
DEMO_STAFF_USER_ID=
DEMO_STAFF_EMAIL=
DEMO_STAFF_PASSWORD=

# --- App ---
APP_BASE_URL=http://localhost:3000
